{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"target": "ES2020",
		"module": "esnext",
		"sourceMap": true,
		"declaration": true,
		"moduleResolution": "bundler",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"noEmitOnError": true,
		"noEmitHelpers": true,
		"diagnostics": true,
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"lib": ["ESNext", "dom"],
		"types": ["node"],
"plugins": [{
      "transform": "@nativescript/webpack/dist/transformers/NativeClass",
      "type": "raw"
    }]	},
	"exclude": ["node_modules", "tmp", "platforms", "__tests__"]
}